# Local overrides — machine-specific, not for version control
CLAUDE.local.md
AGENTS.local.md
.aioson/config.local.md
# AIOSON — keep shared project memory and tool contracts
!AGENTS.md
!CLAUDE.md
!OPENCODE.md
!.claude/
!.claude/**
!.codex/
!.codex/**
!.aioson/
!.aioson/**
# AIOSON — managed framework files (do not commit)
.aioson/config.md
.aioson/locales/
.aioson/skills/
.aioson/schemas/
.aioson/tasks/
.aioson/templates/
.aioson/advisors/
.aioson/mcp/servers.md
# AIOSON — user-installed skills (local-only, not versioned)
# NOTE: template/.aioson/installed-skills/ is unaffected — root-anchored rule.
.aioson/installed-skills/
!.aioson/installed-skills/.gitkeep
# AIOSON — custom agents (versioned with project)
!.aioson/my-agents/
!.aioson/my-agents/**
# AIOSON — local-only artifacts
aioson-logs/
aioson-models.json
.aioson/backups/
.aioson/cloud-imports/
.aioson/runtime/
# The template ships a tree, not a session: a stray runtime db or live-session
# file under template/.aioson/runtime/ would enter history and ride along with
# every template walk. The installer already refuses to copy it; this keeps it
# out of the repository in the first place.
template/.aioson/runtime/
.aioson/mcp/presets/
.aioson/install.json
.aioson/mcp/servers.local.json
.aioson/profiler-reports/*
!.aioson/profiler-reports/.gitkeep
# generated gate reports (runtime artifacts — audit:code / rules:check / verify:artifact)
.aioson/context/audit-code.json
.aioson/context/rules-check.json
.aioson/context/verify-artifact-*.json
.claude/settings.local.json
*:Zone.Identifier
integrations/*
# AIOSON — user-installed skills (versioned with project)
!.aioson/installed-skills/
!.aioson/installed-skills/**
# AIOSON — shared agent scratch caches (local-only)
# AIOSON — regenerable browser evidence (captures and walkthrough snapshots; the reports beside them stay tracked)
.aioson/context/visual-screenshots/
.aioson/context/features/*/visual-screenshots/
.aioson/context/done/*/dossier/visual-screenshots/
.aioson/context/done/*/briefings/visual-screenshots/
.aioson/briefings/*/visual-screenshots/
.aioson/context/browser/*/
.aioson/context/features/*/browser/*/
.aioson/context/done/*/dossier/browser/*/
.aioson/context/done/*/briefings/browser/*/
.aioson/briefings/*/browser/*/
